# Settings for docker-compose.yml. docs/self-hosting.md describes each one.

# Change all three before the first start. The bootstrap token can create
# Felix tenants and cluster credentials; the Raft peer token (32 characters
# or more) can replace the Felix metadata; the secret key seals every secret
# the relay stores. Make each with `openssl rand -base64 32`.
FELIX_BOOTSTRAP_TOKEN=change-me
FELIX_RAFT_PEER_TOKEN=change-me-to-at-least-32-random-characters
RELAY_SECRET_KEY=

# Where senders and browsers reach the relay.
RELAY_BIND=127.0.0.1
RELAY_PORT=8090
RELAY_PUBLIC_URL=http://127.0.0.1:8090

# Relay tenants, and who administers each as tenant=admin,admin separated by
# spaces. An admin is a value of RELAY_OIDC_SUBJECT_CLAIM.
RELAY_TENANTS=acme
RELAY_TENANT_ADMINS=acme=alice@example.com

# The identity provider admins sign in with. These point at the stand-in Dex
# in dex.yaml; replace them with your provider's and remove dev-idp from
# COMPOSE_PROFILES.
COMPOSE_PROFILES=dev-idp
RELAY_OIDC_ISSUER=http://127.0.0.1:5556/dex
RELAY_OIDC_INTERNAL_URL=http://dex:5556/dex
RELAY_OIDC_JWKS_URL=http://dex:5556/dex/keys
RELAY_OIDC_CLIENT_ID=relay-admin
RELAY_OIDC_CLIENT_SECRET=dev-admin-secret
RELAY_OIDC_SUBJECT_CLAIM=email
